package testdata

@haml ChildrenTest(v string) {
	.passed-in= v
	.children
		=@children
	.after After children
}

@haml RenderTest() {
	.parent
		.local This is local content
		=@render ChildrenTest("This is passed-in content")
			.child This is child content
		.after After parent
}

@haml RenderWithSlotTest() {
	=@render ChildrenTest("")
		=@slot content
}

@haml WrapperTest() {
	.wrapper
		.list
			=@children
}

@haml WrappedTest(v string) {
	.item= v
}

@haml NestedRenderTest() {
	=@render WrapperTest()
		=@render WrappedTest("first")
		=@render WrappedTest("second")
}

@haml SlotTest() {
	.wrapper
		=@slot first
		=@slot second
		=@slot third
}

@haml SlotWithDefaultTest() {
	.wrapper
		=@slot first
			%p Default first
		=@slot second
			%p Default second
		=@slot third
			%p Default third
}

@ego EgoRenderTest() {
	<%@render ChildrenTest("without a block") %>
	<%@render ChildrenTest("without a block, trimmed newline") $%>

	<%@render ChildrenTest("empty block") { %><% } %>
	<%@render ChildrenTest("empty block on two lines") { -%>
	<%- } %>
	<%@render ChildrenTest("block with a blank line") { %>
	<%@render WrappedTest("first") $%>

	<% if true { -%>
	<div class="item">second</div>
	<%- } %>
	<% } $%>
	<%@render WrapperTest() { %><%@render WrappedTest("first") $%> <%@render WrappedTest("second") $%><% } $%>
	<div class="after">After renders</div><%# trimmed to the end of the template -%>
}
