package testdata

@haml SlotDirectiveItem(value string) {
	.item= value
}

@haml HamlSlotDirectives() {
	.items
		= @ifslot content
			= @eachslot item in content
				= @render item
		= @noslot content
			.empty No items
}

@slim SlimSlotDirectives() {
	.items
		= @ifslot content
			= @eachslot item in content
				= @render item
}

@slim ChildrenPresence() {
	.container
		= @ifslot children
			.present children are present
}

@ego EgoSlotDirectives() {
	<div class="items">
		<%@ifslot content { %>
			<%@eachslot item in content { %>
				<%@render item %>
			<% } %>
		<% } %>
	</div>
}
