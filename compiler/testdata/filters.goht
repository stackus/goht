package testdata

@goht FiltersTest() {
	- str := "Interpolated <em>text</em>"
	%p
		:plain
			Plain <em>text</em>
			#{str}
			\#{str}
	%p
		:plain
				Indented Plain <em>text</em>
				#{str}
	%p
		:escaped
			Escaped <em>text</em>
			#{str}
	%p
		:preserve
			Preserved <em>text</em>
			#{str}
	.nesting
		:javascript
			console.log("#{str}");
			console.log("\#{str}\n");
			if (true) {
				console.log("#{str}");
			}
	- color := "red"
	:css
		.red {
			color: #{color};
		}
		.blue {
			color: blue;
		}
}

@slim SlimFiltersTest() {
	- str := "Interpolated <em>text</em>"
	:javascript
		console.log("#{str}");
		console.log("\#{str}\n");
	- color := "red"
	:css
		.red {
			color: #{color};
		}
}
