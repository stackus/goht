// Grammar-Kit BNF grammar for the GoHT template language.
// Token names map 1-to-1 to the tokenType constants in compiler/tokens.go.
// Update the package/class names below when the JetBrains plugin project is named.
{
  parserClass="com.github.stackus.goht.parser.GoHTParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="GoHT"
  psiImplClassSuffix="Impl"
  psiPackage="com.github.stackus.goht.psi"
  psiImplPackage="com.github.stackus.goht.psi.impl"

  elementTypeHolderClass="com.github.stackus.goht.psi.GoHTTypes"
  elementTypeClass="com.github.stackus.goht.psi.GoHTElementType"
  tokenTypeClass="com.github.stackus.goht.psi.GoHTTokenType"

  tokens=[
    // ── structure ─────────────────────────────────────────────────────────────
    EOF             ='tEOF'
    NEW_LINE        ='tNewLine'
    INDENT          ='tIndent'

    // ── go-level ──────────────────────────────────────────────────────────────
    PACKAGE         ='tPackage'
    IMPORT          ='tImport'
    GO_CODE         ='tGoCode'

    // ── template boundaries ───────────────────────────────────────────────────
    TEMPLATE_START  ='tTemplateStart'
    TEMPLATE_END    ='tTemplateEnd'
    KEEP_NEWLINES   ='tKeepNewlines'

    // ── html structural ───────────────────────────────────────────────────────
    DOCTYPE         ='tDoctype'
    TAG             ='tTag'
    ID              ='tId'
    CLASS           ='tClass'
    OBJECT_REF      ='tObjectRef'
    VOID_TAG        ='tVoidTag'

    // ── attributes ────────────────────────────────────────────────────────────
    ATTR_NAME           ='tAttrName'
    ATTR_OPERATOR       ='tAttrOperator'
    ATTR_ESCAPED_VALUE  ='tAttrEscapedValue'
    ATTR_DYNAMIC_VALUE  ='tAttrDynamicValue'

    // ── text content ──────────────────────────────────────────────────────────
    RAW_TEXT        ='tRawText'
    ESCAPED_TEXT    ='tEscapedText'
    DYNAMIC_TEXT    ='tDynamicText'
    PLAIN_TEXT      ='tPlainText'
    PRESERVE_TEXT   ='tPreserveText'

    // ── comments ──────────────────────────────────────────────────────────────
    COMMENT         ='tComment'
    RUBY_COMMENT    ='tRubyComment'

    // ── whitespace modifiers (haml) ───────────────────────────────────────────
    NUKE_INNER_WHITESPACE ='tNukeInnerWhitespace'
    NUKE_OUTER_WHITESPACE ='tNukeOuterWhitespace'

    // ── whitespace modifiers (slim) ───────────────────────────────────────────
    ADD_WHITESPACE_BEFORE ='tAddWhitespaceBefore'
    ADD_WHITESPACE_AFTER  ='tAddWhitespaceAfter'

    // ── code output ───────────────────────────────────────────────────────────
    UNESCAPED       ='tUnescaped'
    SCRIPT          ='tScript'
    SILENT_SCRIPT   ='tSilentScript'

    // ── commands ──────────────────────────────────────────────────────────────
    RENDER_COMMAND      ='tRenderCommand'
    CHILDREN_COMMAND    ='tChildrenCommand'
    SLOT_COMMAND        ='tSlotCommand'
    ATTRIBUTES_COMMAND  ='tAttributesCommand'

    // ── filters ───────────────────────────────────────────────────────────────
    FILTER_START    ='tFilterStart'
    FILTER_END      ='tFilterEnd'
  ]
}

// ════════════════════════════════════════════════════════════════════════════
// Root
// ════════════════════════════════════════════════════════════════════════════

// A GoHT file begins with a package declaration, followed by any number of
// imports, free Go code lines, or template declarations (in any order).
gohtFile ::= packageDecl (importDecl | goCodeLine | template | NEW_LINE)* {
  recoverWhile="gohtFile_recover"
}

private gohtFile_recover ::= !<<eof>>

// ════════════════════════════════════════════════════════════════════════════
// Go-level constructs  (compiler/lexers.go: lexPackage, lexImports, lexGoCode)
// ════════════════════════════════════════════════════════════════════════════

// lexPackage: skips "package" keyword, emits tPackage for the package name.
packageDecl ::= PACKAGE

// lexImportStart / lexImports: emits one tImport token per import path.
// Both single-line ("import \"foo\"") and block ("import (\n...\n)") forms
// collapse to one IMPORT token each — the lexer strips the parens and whitespace.
importDecl ::= IMPORT+

// lexGoCode: one tGoCode token per non-blank, non-special line.
goCodeLine ::= GO_CODE

// ════════════════════════════════════════════════════════════════════════════
// Template declarations  (compiler/lexers.go: lexTemplate, lexTemplateStart)
// ════════════════════════════════════════════════════════════════════════════

// lexTemplate dispatches on @goht/@haml/@slim/@ego.
// lexTemplateStart emits: TEMPLATE_START (function signature), then
//   KEEP_NEWLINES only for @haml/@goht (preserves blank lines between tags).
template ::= hamlTemplate | slimTemplate | egoTemplate

// @haml / @goht
hamlTemplate ::= TEMPLATE_START KEEP_NEWLINES hamlBody TEMPLATE_END

// @slim
slimTemplate ::= TEMPLATE_START slimBody TEMPLATE_END

// @ego
egoTemplate ::= TEMPLATE_START egoBody TEMPLATE_END

// ════════════════════════════════════════════════════════════════════════════
// Shared attribute rules
// (compiler/lexers_haml.go: lexHamlAttributesStart … lexHamlHtmlAttributesEnd)
// (compiler/lexers_slim.go: same structure)
//
// The { } and ( ) delimiters are consumed by the lexer; only the attribute
// content tokens reach the parser.
// ════════════════════════════════════════════════════════════════════════════

// One or more attribute entries from a { ... } block.
attrList ::= attr+

// A single attribute: name + optional operator + value, OR @attributes command.
attr ::= ATTR_NAME ATTR_OPERATOR attrValue
       | ATTR_NAME                           // boolean attribute (no value)
       | ATTRIBUTES_COMMAND

attrValue ::= ATTR_ESCAPED_VALUE | ATTR_DYNAMIC_VALUE

// HTML-style (parenthesis) attributes — same token stream, distinct PSI nodes.
htmlAttrList ::= htmlAttr+

htmlAttr ::= ATTR_NAME ATTR_OPERATOR attrValue
           | ATTR_NAME
           | ATTRIBUTES_COMMAND

// A command token produced by = @render(...), = @children(), = @slot(...)
gohtCommand ::= RENDER_COMMAND | CHILDREN_COMMAND | SLOT_COMMAND

// ════════════════════════════════════════════════════════════════════════════
// HAML / GoHT body  (compiler/lexers_haml.go)
//
// Syntax overview:
//   %tag[#id][.class][{attrs}][(html-attrs)][[obj-ref]][modifiers] [content]
//   #id  .class  (shortcuts — no % needed)
//   \ escaped plain text line
//   - silent Go code
//   = Go expression (output, escaped)
//   != unescaped output
//   / HTML comment
//   -# Ruby/silent comment (line ignored)
//   !!! doctype
//   :filtername  (javascript|css|plain|escaped|preserve)
//
// Indentation is tab-only; each line starts with an INDENT token whose
// literal value is the run of tabs for that nesting level.
// ════════════════════════════════════════════════════════════════════════════

hamlBody ::= (hamlLine | NEW_LINE)*

// Every content line carries exactly one leading INDENT.
hamlLine ::= INDENT hamlNode

hamlNode ::=
    hamlDoctype
  | hamlComment
  | hamlRubyComment
  | hamlFilter
  | hamlElement
  | hamlUnescapedOutput
  | hamlOutput
  | hamlSilentScript
  | hamlInlineText

// !!! [type]  (e.g. "!!! 5", "!!! Strict")
hamlDoctype ::= DOCTYPE

// /[comment text]
hamlComment ::= COMMENT

// -# comment (entire indented block is discarded by lexer)
hamlRubyComment ::= RUBY_COMMENT

// :filtername followed by indented content block
hamlFilter ::= FILTER_START hamlFilterBody FILTER_END

hamlFilterBody ::= (hamlFilterLine | NEW_LINE)*

hamlFilterLine ::= INDENT hamlFilterContent+

// Filter content tokens vary by filter type:
//   plain/javascript/css → PLAIN_TEXT
//   escaped              → ESCAPED_TEXT
//   preserve             → PRESERVE_TEXT
// All support #{...} interpolation → DYNAMIC_TEXT
hamlFilterContent ::= PLAIN_TEXT | ESCAPED_TEXT | PRESERVE_TEXT | DYNAMIC_TEXT

// %tag, #id, .class — core element, with zero or more modifiers
hamlElement ::= hamlElementHead hamlElementMod* hamlWhitespaceModifier? hamlTagContent?

// The leading token determines element type
hamlElementHead ::= TAG | ID | CLASS

// Additional modifiers that can follow the head (any order, any count)
hamlElementMod ::= ID | CLASS | OBJECT_REF | attrList | htmlAttrList

// > removes outer whitespace; < removes inner whitespace
hamlWhitespaceModifier ::= NUKE_OUTER_WHITESPACE | NUKE_INNER_WHITESPACE

// What can appear after the element and its modifiers on the same logical line
hamlTagContent ::=
    VOID_TAG                  // self-closing: /
  | hamlUnescapedOutput       // != or !
  | hamlOutput                // = expr or = @command
  | hamlInlineText            // plain text (possibly with interpolation)

// != expr  or  ! (bare unescaped marker, content on same line)
hamlUnescapedOutput ::= UNESCAPED SCRIPT?

// = expr  or  = @render(...) / @children() / @slot(...)
hamlOutput ::= SCRIPT | gohtCommand

// - Go code (no output)
hamlSilentScript ::= SILENT_SCRIPT

// Plain text possibly containing #{...} interpolation spans
hamlInlineText ::= (PLAIN_TEXT | DYNAMIC_TEXT)+

// ════════════════════════════════════════════════════════════════════════════
// Slim body  (compiler/lexers_slim.go)
//
// Syntax overview:
//   tagname[#id][.class][{attrs}][(html-attrs)][modifiers] [content]
//   #id  .class  (shortcuts)
//   - control code (silent Go)
//   = expr   (escaped output)
//   == expr  (unescaped output — lexer emits UNESCAPED then SCRIPT)
//   /  Ruby comment (discarded by lexer)
//   /! HTML comment
//   : filtername  (javascript|css)
//   | text block
//   doctype [type]
//
// Inline nesting: `li: a href="/" Home`
// Tab-only indentation; each content line starts with one INDENT token.
// ════════════════════════════════════════════════════════════════════════════

slimBody ::= (slimLine | NEW_LINE)*

slimLine ::= INDENT slimNode

slimNode ::=
    slimDoctype
  | slimComment
  | slimRubyComment
  | slimFilter
  | slimElement
  | slimOutput
  | slimControlCode
  | slimTextBlock

// doctype [type]  (tag name "doctype" is special-cased by the lexer)
slimDoctype ::= DOCTYPE

// /! HTML comment (content stored as COMMENT token)
slimComment ::= COMMENT

// / Ruby comment (content discarded by lexer, only RUBY_COMMENT token emitted)
slimRubyComment ::= RUBY_COMMENT

// :filtername followed by indented content block
slimFilter ::= FILTER_START slimFilterBody FILTER_END

slimFilterBody ::= (slimFilterLine | NEW_LINE)*

slimFilterLine ::= INDENT slimFilterContent+

// Slim filters support plain text and #{...} interpolation
slimFilterContent ::= PLAIN_TEXT | DYNAMIC_TEXT

// tagname, #id, or .class — with optional modifiers
slimElement ::= slimElementHead slimElementMod* slimWhitespaceModifier? slimTagContent?

slimElementHead ::= TAG | ID | CLASS

slimElementMod ::= ID | CLASS | attrList | htmlAttrList

// > adds space after; < adds space before
slimWhitespaceModifier ::= ADD_WHITESPACE_AFTER | ADD_WHITESPACE_BEFORE

slimTagContent ::=
    VOID_TAG                  // self-closing: /
  | slimOutput                // = or == expr / command
  | slimInlineElement         // : nested-tag (inline)
  | slimInlineText            // plain text after space

// Inline nesting: the rest of the line is parsed as another slimNode
slimInlineElement ::= slimNode

// == expr (unescaped) or = expr or = @command
slimOutput ::= UNESCAPED? (SCRIPT | gohtCommand)

// - code (no output)
slimControlCode ::= SILENT_SCRIPT

// | text … (multi-line; each continuation line emits NEW_LINE + INDENT + content)
slimTextBlock ::= (PLAIN_TEXT | DYNAMIC_TEXT | NEW_LINE | INDENT)*

slimInlineText ::= (PLAIN_TEXT | DYNAMIC_TEXT)+

// ════════════════════════════════════════════════════════════════════════════
// EGO body  (compiler/lexers_ego.go)
//
// ERB-style tags embedded in raw text:
//   <% code %>          silent script (no output)
//   <%= expr %>         escaped output
//   <%! expr %>         unescaped output
//   <%# comment %>      comment (discarded by lexer, no token emitted)
//   <%@ render … %>     render command
//   <%@ children %>     children command
//   <%@ slot name %>    slot command
//
// Closing tag variants (consumed by lexer):
//   %>    standard close
//   -%>   close + strip trailing whitespace
//   $%>   close + consume following newline
//
// Brace tracking: when a script or command opens/closes a Go block ({ / }),
// the lexer emits INDENT (value = current tab depth) before/after the token
// so the parser can reconstruct block nesting.
//
// All lines inside an EGO template must begin with a tab (enforced by lexer).
// ════════════════════════════════════════════════════════════════════════════

egoBody ::= egoItem*

egoItem ::=
    RAW_TEXT              // literal template text between tags
  | NEW_LINE              // line boundary
  | INDENT               // Go block depth change (emitted around { / })
  | egoOutput            // <%= expr %>
  | egoUnescapedOutput   // <%! expr %>
  | egoScript            // <% code %>
  | egoCommand           // <%@ ... %>

// <%= expr %>  — lexer emits SCRIPT only
egoOutput ::= SCRIPT

// <%! expr %>  — lexer emits UNESCAPED then SCRIPT
egoUnescapedOutput ::= UNESCAPED SCRIPT

// <% code %>  — lexer emits SILENT_SCRIPT
// Surrounding INDENT tokens (if any) are captured as sibling egoItems.
egoScript ::= SILENT_SCRIPT

// <%@ render|children|slot ... %>
egoCommand ::= RENDER_COMMAND | CHILDREN_COMMAND | SLOT_COMMAND
